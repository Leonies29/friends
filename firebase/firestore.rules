rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid));
    }

    function hasActiveMembershipDoc(groupId) {
      return exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid))
        && memberDoc(groupId).data.status == 'active';
    }

    function isListedGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/friendGroups/$(groupId))
        && (
          request.auth.uid in get(/databases/$(database)/documents/friendGroups/$(groupId)).data.get('memberIds', [])
          || get(/databases/$(database)/documents/friendGroups/$(groupId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/friendGroups/$(groupId)).data.createdBy == request.auth.uid
        );
    }

    function isGroupMember(groupId) {
      return isSignedIn() && (hasActiveMembershipDoc(groupId) || isListedGroupMember(groupId));
    }

    function hasPrivilegedMembership(groupId) {
      return exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid))
        && memberDoc(groupId).data.role in ['OWNER', 'ADMIN'];
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/friendGroups/$(groupId))
        && (
          get(/databases/$(database)/documents/friendGroups/$(groupId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/friendGroups/$(groupId)).data.createdBy == request.auth.uid
          || (
            request.auth.token.email != null
            && get(/databases/$(database)/documents/friendGroups/$(groupId)).data.get('ownerEmail', '') == request.auth.token.email
          )
        );
    }

    function isGroupAdmin(groupId) {
      return isGroupOwner(groupId) || hasPrivilegedMembership(groupId);
    }

    function canManageGroup(groupId) {
      return isGroupAdmin(groupId);
    }

    function scopedGroupId() {
      return request.resource != null ? request.resource.data.groupId : resource.data.groupId;
    }

    // Accounts
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Group scaffolding (invite lookup works before sign-in)
    match /friendGroups/{groupId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && canManageGroup(groupId);
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && canManageGroup(groupId);
    }

    match /appConfig/{groupId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && canManageGroup(groupId);
    }

    match /groupMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn()
        && (
          request.auth.uid == resource.data.userId
          || canManageGroup(resource.data.groupId)
        );
      allow delete: if isSignedIn() && canManageGroup(resource.data.groupId);
    }

    // Games & scoring
    match /games/{gameId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && canManageGroup(request.resource.data.groupId);
      allow update, delete: if isSignedIn() && canManageGroup(resource.data.groupId);
    }

    match /gameSessions/{sessionId} {
      allow read, create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && canManageGroup(scopedGroupId());
    }

    match /xpTransactions/{transactionId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow delete: if isSignedIn() && canManageGroup(resource.data.groupId);
    }

    match /leaderboards/{entryId} {
      allow read, create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && canManageGroup(scopedGroupId());
    }

    // Photos
    match /photos/{photoId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isSignedIn() && (
        canManageGroup(resource.data.groupId)
        || request.auth.uid == resource.data.ownerId
      );
    }

    match /photoReactions/{reactionId} {
      allow read, create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && (isGroupMember(scopedGroupId()) || canManageGroup(scopedGroupId()));
    }

    match /photoComments/{commentId} {
      allow read, create: if isSignedIn() && isGroupMember(scopedGroupId());
      allow update, delete: if isSignedIn() && (isGroupMember(scopedGroupId()) || canManageGroup(scopedGroupId()));
    }

    // Quests & planning
    match /quests/{questId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create: if isSignedIn() && canManageGroup(request.resource.data.groupId);
      allow update, delete: if isSignedIn() && canManageGroup(resource.data.groupId);
    }

    match /questRelics/{relicId} {
      allow read, create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && canManageGroup(resource.data.groupId);
    }

    match /questCompletions/{completionId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && canManageGroup(resource.data.groupId);
    }

    match /scheduleEvents/{eventId} {
      allow read: if isSignedIn() && isGroupMember(resource.data.groupId);
      allow create, update, delete: if isSignedIn() && (
        isGroupMember(scopedGroupId())
        || canManageGroup(resource.data.groupId)
      );
    }

    match /notifications/{notificationId} {
      allow read, create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && canManageGroup(scopedGroupId());
    }

    match /badges/{badgeId} {
      allow read, create, update: if isSignedIn() && isGroupMember(scopedGroupId());
      allow delete: if isSignedIn() && canManageGroup(scopedGroupId());
    }

    // Bingo
    match /bingoChallenges/{challengeId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId)
        && request.resource.data.gameId is string
        && request.resource.data.title is string
        && request.resource.data.description is string;
      allow update, delete: if canManageGroup(resource.data.groupId);
    }

    match /bingoSessions/{sessionId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /bingoCards/{cardId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId)
        || (
          isGroupMember(request.resource.data.groupId)
          && request.auth.uid == request.resource.data.userId
          && exists(/databases/$(database)/documents/bingoSessions/$(request.resource.data.groupId + '_' + request.resource.data.gameId))
          && get(/databases/$(database)/documents/bingoSessions/$(request.resource.data.groupId + '_' + request.resource.data.gameId)).data.status == 'active'
        );
      allow update: if canManageGroup(resource.data.groupId)
        || (
          isGroupMember(resource.data.groupId)
          && request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['cells', 'updatedAt'])
        );
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /bingoSubmissions/{submissionId} {
      allow read: if isGroupMember(resource.data.groupId)
        && (canManageGroup(resource.data.groupId) || request.auth.uid == resource.data.userId);
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending';
      allow update: if canManageGroup(resource.data.groupId)
        || (
          request.auth.uid == resource.data.userId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
        );
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /bingoPlayers/{playerId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId)
        || isGroupMember(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /bingoLeaderboard/{entryId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId)
        || isGroupMember(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    // Quiz
    match /quizQuestions/{questionId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId);
      allow update, delete: if canManageGroup(resource.data.groupId);
    }

    match /quizSessions/{sessionId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.auth.uid == request.resource.data.userId;
      allow update: if isGroupMember(resource.data.groupId)
        && request.auth.uid == resource.data.userId;
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /quizAnswers/{answerId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.auth.uid == request.resource.data.userId;
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /quizLeaderboard/{entryId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if isGroupMember(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    // Assassin
    match /assassinGames/{gameId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /assassinPlayers/{playerId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId)
        || isGroupMember(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /assassinMissions/{missionId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId)
        || isGroupMember(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /assassinEliminations/{eliminationId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
        && request.auth.uid == request.resource.data.killerId
        && request.resource.data.status == 'pending';
      allow update: if isGroupMember(resource.data.groupId)
        && (
          (request.auth.uid == resource.data.victimId && resource.data.status == 'pending')
          || canManageGroup(resource.data.groupId)
        );
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /assassinSetups/{setupId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if canManageGroup(request.resource.data.groupId);
      allow delete: if canManageGroup(setupId);
    }

    match /assassinMissionTemplates/{templateId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId);
      allow update, delete: if canManageGroup(resource.data.groupId);
    }

    match /activityFeed/{entryId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId);
      allow delete: if canManageGroup(resource.data.groupId);
    }

    // Secret challenges
    match /challenges/{challengeId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
        && (
          canManageGroup(request.resource.data.groupId)
          || (
            request.auth.uid == request.resource.data.assignedById
            && request.resource.data.ownerId != request.auth.uid
          )
        );
      allow update: if canManageGroup(resource.data.groupId)
        || (
          isGroupMember(resource.data.groupId)
          && request.auth.uid == resource.data.ownerId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'proof', 'updatedAt'])
        );
      allow delete: if canManageGroup(resource.data.groupId);
    }

    // Awards
    match /votes/{voteId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create, update: if isGroupMember(request.resource.data.groupId)
        && request.auth.uid == request.resource.data.voterId;
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /awardCategories/{categoryId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId);
      allow update, delete: if canManageGroup(resource.data.groupId);
    }
  }
}
